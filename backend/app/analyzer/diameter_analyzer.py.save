import subprocess
from dataclasses import dataclass, asdict
from typing import Optional


@dataclass
class DiameterPacket:
    frame_number: str
    time_relative: float
    source: str
    destination: str
    command_code: Optional[int]
    is_request: bool
    hop_by_hop_id: Optional[str]

    answer_in: Optional[str]
    answer_to: Optional[str]

    response_time: Optional[float]
    result_code: Optional[int]


@dataclass
class DiameterTransaction:
    request_frame: str
    answer_frame: Optional[str]

    command_code: Optional[int]

    request_source: str
    request_destination: str

    answer_source: Optional[str]
    answer_destination: Optional[str]

    request_time: float
    answer_time: Optional[float]

    latency_ms: Optional[float]

    result_code: Optional[int]

    result: str


def to_int(value: str) -> Optional[int]:

    if not value:
        return None

    try:
        return int(value)

    except ValueError:
        return None


def to_float(value: str) -> Optional[float]:

    if not value:
        return None

    try:
        return float(value)

    except ValueError:
        return None
def parse_diameter_packets(pcap_file):
    command = [
        "tshark",
        "-r", pcap_file,
        "-Y", "diameter",
        "-T", "fields",
        "-E", "separator=\t",
        "-E", "quote=d",
        "-e", "frame.number",
        "-e", "frame.time_relative",
        "-e", "ip.src",
        "-e", "ip.dst",
        "-e", "diameter.cmd.code",
        "-e", "diameter.flags.request",
        "-e", "diameter.hopbyhopid",
        "-e", "diameter.answer_in",
        "-e", "diameter.answer_to",
        "-e", "diameter.resp_time",
        "-e", "diameter.Result-Code",
    ]

    result = subprocess.run(
        command,
        capture_output=True,
        text=True,
        check=True,
    )

    packets = []

    for line in result.stdout.splitlines():
        if not line.strip():
            continue

        fields = line.split("\t")

        if len(fields) < 11:
            continue

        def clean(value):
            value = value.strip().strip('"')
            return value if value else None

        frame_number = clean(fields[0])
        time_relative = clean(fields[1])
        source = clean(fields[2])
        destination = clean(fields[3])
        command_code = clean(fields[4])
        is_request = clean(fields[5])
        hop_by_hop_id = clean(fields[6])
        answer_in = clean(fields[7])
        answer_to = clean(fields[8])
        response_time = clean(fields[9])
        result_code = clean(fields[10])

        packets.append(
            DiameterPacket(
                frame_number=int(frame_number),
                time_relative=float(time_relative),
                source=source,
                destination=destination,
                command_code=int(command_code) if command_code else None,
                is_request=is_request == "1",
                hop_by_hop_id=hop_by_hop_id,
                answer_in=int(answer_in) if answer_in else None,
                answer_to=int(answer_to) if answer_to else None,
                response_time=float(response_time) if response_time else None,
                result_code=int(result_code) if result_code else None,
            )
        )

    return packets


def correlate_transactions(
    packets: list[DiameterPacket],
) -> list[DiameterTransaction]:

    packet_map = {
        packet.frame_number: packet
        for packet in packets
    }

    transactions = []

    for answer in packets:

        # We only process Diameter answers that Wireshark
        # explicitly correlated to a request.
        if answer.is_request:
            continue

        if not answer.answer_to:
            continue

        request = packet_map.get(
            answer.answer_to
        )

        if request is None:
            continue

        latency_ms = None

        if answer.response_time is not None:

            latency_ms = (
                answer.response_time * 1000
            )

        else:

            latency_ms = (
                answer.time_relative
                - request.time_relative
            ) * 1000

        if answer.result_code == 2001:

            result = "PASS"

        elif answer.result_code is None:

            result = "UNKNOWN"

        else:

            result = "FAIL"

        transactions.append(

            DiameterTransaction(

                request_frame=request.frame_number,

                answer_frame=answer.frame_number,

                command_code=answer.command_code,

                request_source=request.source,

                request_destination=request.destination,

                answer_source=answer.source,

                answer_destination=answer.destination,

                request_time=request.time_relative,

                answer_time=answer.time_relative,

                latency_ms=latency_ms,

                result_code=answer.result_code,

                result=result,
            )
        )

    return transactions


def analyze_diameter(
    pcap_file: str,
) -> dict:

    packets = parse_diameter_packets(
        pcap_file
    )

    transactions = correlate_transactions(
        packets
    )

    successful = [
        transaction
        for transaction in transactions
        if transaction.result == "PASS"
    ]

    failed = [
        transaction
        for transaction in transactions
        if transaction.result == "FAIL"
    ]

    return {

        "packet_count": len(packets),

        "transaction_count": len(
            transactions
        ),

        "successful_transactions": len(
            successful
        ),

        "failed_transactions": len(
            failed
        ),

        "transactions": [
            asdict(transaction)
            for transaction in transactions
        ],
    }


if __name__ == "__main__":

    import sys

    if len(sys.argv) != 2:

        print()

        print(
            "Usage:"
        )

        print(
            "python3 "
            "backend/app/analyzer/"
            "diameter_analyzer.py "
            "<capture.pcapng>"
        )

        print()

        sys.exit(1)

    pcap_file = sys.argv[1]

    result = analyze_diameter(
        pcap_file
    )

    print()

    print("=" * 70)

    print(
        "DIAMETER ANALYZER"
    )

    print("=" * 70)

    print()

    print(
        f"Diameter packets      : "
        f"{result['packet_count']}"
    )

    print(
        f"Transactions          : "
        f"{result['transaction_count']}"
    )

    print(
        f"Successful            : "
        f"{result['successful_transactions']}"
    )

    print(
        f"Failed                : "
        f"{result['failed_transactions']}"
    )

    print()













    print(
        "First 10 transactions"
    )

    print("-" * 70)

    for transaction in result[
        "transactions"
    ][:10]:

        latency = transaction[
            "latency_ms"
        ]

        latency_text = (
            f"{latency:.3f} ms"
            if latency is not None
            else "N/A"
        )

        print(
            f"{transaction['request_frame']}"
            f" -> "
            f"{transaction['answer_frame']}"
            f" | CMD "
            f"{transaction['command_code']}"
            f" | "
            f"{transaction['result']}"
            f" | "
            f"{latency_text}"
            f" | Result "
            f"{transaction['result_code']}"
        )

    print()

    print("=" * 70)

